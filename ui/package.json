{
  "name": "selfishnetwork",
  "version": "0.1.0",
  "description": "Electron + React UI for SelfishNetwork",
  "private": true,
  "author": {
    "name": "Snipyer",
    "email": "snipyergaming@gmail.com"
  },
  "homepage": "https://github.com/Snipyer/selfishnet",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "build": {
    "appId": "com.selfishnet.app",
    "productName": "SelfishNetwork",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../core/target/release/selfishnet-core",
        "to": "bin/selfishnet-core"
      },
      {
        "from": "../scripts/setcap-core.sh",
        "to": "bin/setcap-core.sh"
      },
      {
        "from": "public/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "linux": {
      "executableName": "selfishnet",
      "icon": "public/app-icon.png",
      "category": "Network",
      "synopsis": "Manage your own local network",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "deb": {
      "artifactName": "${productName}-${version}.${ext}",
      "afterInstall": "build/deb-after-install.sh",
      "afterRemove": "build/deb-after-remove.sh"
    }
  }
}
